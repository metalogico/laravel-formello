{
    "name": "metalogico/laravel-formello",
    "description": "A Laravel package for generating Bootstrap 5 and Tailwind CSS 4 forms based on models",
    "keywords": [
        "laravel",
        "forms",
        "form-builder",
        "bootstrap",
        "metalogico"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/metalogico/laravel-formello",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Metalogico\\Formello\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Metalogico",
            "email": "michele.brandolin@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Metalogico\\Formello\\FormelloServiceProvider"
            ],
            "aliases": {
                "Formello": "Metalogico\\Formello\\Facades\\Formello"
            }
        }
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}